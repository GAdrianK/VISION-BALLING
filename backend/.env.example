# Configuration — Football IQ Assistant Backend

# ─────────────────────────────────────────────────────────────
# OPENAI (optionnel)
# ─────────────────────────────────────────────────────────────
# Laisser vide ou préfixer avec "mock-" pour le mode offline TF-IDF local.
# En mode offline, le RAG fonctionne sans API externe.
# Fournir une vraie clé pour activer GPT-4o-mini et des réponses enrichies.
#
# Exemple clé réelle  : OPENAI_API_KEY=your-openai-key-here
# Exemple mode offline : OPENAI_API_KEY=mock-local-only
#
OPENAI_API_KEY=mock-local-only

# ─────────────────────────────────────────────────────────────
# SERVEUR
# ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────────
# SÉCURITÉ CORS
# ─────────────────────────────────────────────────────────────
# Origines autorisées séparées par des virgules (ex: https://mon-app.netlify.app,http://localhost:3000)
# Utiliser "*" en local pour tout autoriser sans restriction.
ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────
# ANALYSE VIDÉO & INTELLIGENCE TACTIQUE — Release Candidate (RC2)
# ─────────────────────────────────────────────────────────────
# Modes canoniques supportés :
# 1. QUALITY (défaut production) : RF-DETR Small @ 960px sur CUDA + BoT-SORT + PnLCalib + Fusion Tactique
# 2. LOW_LATENCY : YOLO11n @ 640px sur CUDA/CPU + ByteTrack
#
# IMPORTANT : Le mode QUALITY requiert le checkpoint verrouillé RF-DETR (EXP-04).
# Renseignez VIDEO_MODEL_PATH avec le chemin absolu vers votre checkpoint_best_total.pth.
# Empreinte SHA-256 obligatoire :
# c1a1d88b74edc5ddefa7da4581e2848c4c58c3938d88ad4a1b615f071752ffff
#
VIDEO_MODE=QUALITY
VIDEO_FRAME_SAMPLE_RATE=1
VIDEO_DETECTOR=rfdetr
# Chemin vers le checkpoint verrouillé (ex: /path/to/checkpoint_best_total.pth)
VIDEO_MODEL_PATH=
VIDEO_MODEL_PROFILE=football
VIDEO_CONFIDENCE_THRESHOLD=0.35
VIDEO_PERSON_CONFIDENCE_THRESHOLD=0.35
VIDEO_BALL_CONFIDENCE_THRESHOLD=0.25
VIDEO_MODEL=rf-detr-small
VIDEO_DEVICE=cuda
VIDEO_TRACKING_ENABLED=true
VIDEO_TRACKER=botsort

# Stockage et limites
VIDEO_UPLOAD_DIR=
VIDEO_RESULT_DIR=
VIDEO_ALLOWED_EXTENSIONS=mp4,mov,mkv,avi,webm
VIDEO_MAX_SIZE_MB=1024
VIDEO_MAX_DURATION_SECONDS=900
VIDEO_MIN_WIDTH=320
VIDEO_MIN_HEIGHT=240
VIDEO_MIN_FREE_DISK_MB=256

# Paramètres temporels et trajectoires ballon
VIDEO_BALL_TRACK_MAX_MISSING_SECONDS=0.2
VIDEO_BALL_TRACK_MAX_DISTANCE_RATIO=0.15
VIDEO_BALL_TRAJECTORY_SECONDS=0.5
VIDEO_PRESERVE_AUDIO=true
VIDEO_MAX_PROCESSING_SECONDS=0
VIDEO_KEEP_TEMPORARY_FILES=false
VIDEO_RETAIN_SOURCE=true
VIDEO_GIT_SHA=

# ─────────────────────────────────────────────────────────────
# BASE DE CONNAISSANCES (chemin relatif depuis backend/)
# ─────────────────────────────────────────────────────────────
# Par défaut, le chemin est résolu automatiquement dans config.py.
# Décommenter uniquement si vous déplacez la knowledge_base.
#
# KNOWLEDGE_BASE_DIR=../football-rag-system/data_football/knowledge_base

# ─────────────────────────────────────────────────────────────
# BASES DE DONNÉES & STOCKAGE (Qdrant & SQLite)
# ─────────────────────────────────────────────────────────────
# QDRANT_URL=:memory: (défaut local) ou http://localhost:6333
QDRANT_URL=:memory:
QDRANT_COLLECTION_NAME=football_intelligence
# SQLITE_DB_PATH=chemin/vers/parent_store.db (laissé vide par défaut pour la résolution automatique)

# ==============================================================================
# VISION-BALLING — PRODUCTION ENVIRONMENT TEMPLATE (Railway CPU Deployment)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real production secrets or connection strings to git.
# - On Railway, these variables are configured in the Railway Dashboard under Service > Variables.
# - In production, GPU processing is disabled (PUBLIC_UPLOAD_ENABLED=false).
# - Video analysis is run locally/offline; this public API handles BETA intake and RAG demo.
# ==============================================================================

# Application Environment Mode
APP_ENV=production

# Public Video Upload Security Gate (FAIL-CLOSED)
PUBLIC_UPLOAD_ENABLED=false
REQUIRE_ANALYSIS_TOKEN=true
MAX_CONCURRENT_ANALYSES=1

# Railway Managed PostgreSQL Database Connection
# Railway automatically injects DATABASE_URL when PostgreSQL is attached to the project.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Data Retention Policies (days)
BETA_REQUEST_RETENTION_DAYS=180
VIDEO_RETENTION_DAYS=14
ANALYSIS_RESULT_RETENTION_DAYS=30

# CORS Allowed Origins
# Specify comma-separated list of production frontend URLs (Cloudflare Pages or custom domains).
# Wildcard '*' is strictly forbidden in production mode.
ALLOWED_ORIGINS=https://app.vision-balling.com,https://vision-balling.pages.dev

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM & RAG Provider Keys
# Set to 'mock-local-only' to operate offline with local TF-IDF embeddings, or provide real production keys.
OPENAI_API_KEY=mock-local-only
OPENROUTER_API_KEY=
